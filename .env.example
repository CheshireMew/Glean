ENV=development
# APP_VERSION 默认读取根目录 VERSION；只有需要显式传递同一版本时才设置。
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_HOME_URL=
PUBLIC_TELEGRAM_URL=
PUBLIC_X_URL=
PUBLIC_BLOG_URL=
PUBLIC_GITHUB_URL=
PUBLIC_BINANCE_URL=
PUBLIC_OKX_URL=
PUBLIC_TUTORIAL_URL=
# 留空时自动生成随机签名密钥，保存在本地数据库；不要提交真实密钥。
JWT_SECRET_KEY=
# 仅用于首次初始化；之后以数据库中的账号为准，可在后台修改。
# 也可保持留空，运行 python -m backend.reset_admin 创建或重置账户。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 可选。留空时在后台“系统配置”中填写。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI 资讯采集后的自动翻译；也可从系统环境变量读取，不要提交真实 Key。
# deepseek-flash，关闭思考，每批最多 10 条，只翻译标题与已有正文前 600 字符。
DEEPSEEK_API_KEY=
