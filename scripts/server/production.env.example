GLEAN_ENV=production
ALLOWED_ORIGINS=https://new.blacknico.com
PUBLIC_SITE_URL=https://new.blacknico.com
# Leave these blank: generate a new signing key in the protected database and
# initialize the administrator interactively with backend.reset_admin.
JWT_SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Only exact trusted local model/SMTP/Webhook hostnames, never an unrestricted CIDR.
GLEAN_PRIVATE_ENDPOINT_HOSTS=
# Shared UTC-day cap for translation, review, enrichment, retries and test calls.
# Currency must match the per-million input/output prices configured for models.
GLEAN_AI_DAILY_MAX_CALLS=1000
GLEAN_AI_DAILY_MAX_COST=5
# Set current per-million token prices from your translation provider's bill.
# A production translation request is rejected while either value is zero.
GLEAN_TRANSLATION_INPUT_PRICE=0
GLEAN_TRANSLATION_OUTPUT_PRICE=0
DEEPSEEK_API_KEY=
